# Server
PORT=8080

# Proxy LLM — where user requests are forwarded (any OpenAI-compatible endpoint)
# Examples:
#   Ollama (local):  http://localhost:11434/v1
#   Groq (free):     https://api.groq.com/openai/v1
#   OpenAI:          https://api.openai.com/v1
LLM_BASE_URL=http://localhost:11434/v1
LLM_API_KEY=
LLM_MODEL=llama3

# Judge LLM — optional LLM-as-judge for SUSPICIOUS entropy prompts
# Disabled by default. Enable only if you want LLM evaluation of borderline prompts.
# When enabled, suspicious prompts are sent to this provider — consider data privacy.
JUDGE_ENABLED=false
JUDGE_BASE_URL=     # defaults to LLM_BASE_URL if not set
JUDGE_API_KEY=      # defaults to LLM_API_KEY if not set
JUDGE_MODEL=llama3

# Entropy thresholds
ENTROPY_HIGH_THRESHOLD=6.5
ENTROPY_SUSPICIOUS_THRESHOLD=5.5

# Token budget per user per rolling hour window
TOKEN_BUDGET_PER_HOUR=50000

# Penalty TTL in minutes (how long a flagged user stays blocked)
PENALTY_TTL_MINUTES=60

# Rate limit: max requests per minute per user fingerprint
RATE_LIMIT_RPM=60

# Optional: protect the proxy itself with a Bearer token
# AEGIS_API_KEY=your-secret-key
